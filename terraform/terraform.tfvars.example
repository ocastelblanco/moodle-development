# Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize for your environment
#
# cp terraform.tfvars.example terraform.tfvars
# chmod 600 terraform.tfvars  # Protect sensitive data

#############################################
# General Configuration
#############################################

project_name = "moodle"
environment  = "prod"
aws_region   = "us-east-1"
aws_profile  = "default"

#############################################
# Network Configuration
#############################################

# Leave empty to use default VPC
vpc_id    = ""
subnet_id = ""

# IMPORTANT: Change this to your IP address!
# Get your IP: curl ifconfig.me
allowed_ssh_cidrs = ["0.0.0.0/0"]  # CHANGE THIS!

#############################################
# EC2 Instance Configuration
#############################################

instance_type      = "t4g.medium"  # or t4g.large for better performance
key_pair_name      = "my-key-pair"  # CHANGE THIS!
root_volume_size   = 15
data_volume_size   = 25
ebs_volume_type    = "gp3"
ebs_iops          = 3000
ebs_throughput    = 125

# Enable detailed monitoring (additional cost)
enable_detailed_monitoring = false

#############################################
# RDS Configuration
#############################################

create_rds                  = true
db_instance_class          = "db.t4g.micro"
db_engine_version          = "11.8"
db_allocated_storage       = 20
db_max_allocated_storage   = 100
db_name                    = "moodle"
db_username                = "moodleadmin"
db_password                = "YourSecurePassword123!"  # CHANGE THIS!
db_backup_retention_period = 7
db_backup_window          = "03:00-04:00"
db_maintenance_window     = "sun:04:00-sun:05:00"
db_multi_az               = false
db_publicly_accessible    = false

#############################################
# Domain & SSL Configuration
#############################################

domain_name   = "moodle.example.com"  # CHANGE THIS!
admin_email   = "admin@example.com"    # CHANGE THIS!

# Route 53 DNS (optional)
create_route53_record = false
route53_zone_id      = ""

#############################################
# CloudFront CDN (Optional)
#############################################

enable_cloudfront     = false
cloudfront_price_class = "PriceClass_100"  # US, Canada, Europe

#############################################
# Monitoring & Alerting
#############################################

enable_cloudwatch_alarms = true
alarm_email             = ""  # Leave empty to skip email notifications
cpu_alarm_threshold     = 80
memory_alarm_threshold  = 500
disk_alarm_threshold    = 80

#############################################
# Backup Configuration
#############################################

enable_ebs_snapshots    = true
snapshot_retention_days = 7
snapshot_schedule       = "cron(0 2 * * ? *)"  # Daily at 2 AM UTC

#############################################
# Optimization Settings
#############################################

# 0 = auto-calculate based on RAM
php_fpm_max_children = 0

# SWAP configuration
enable_swap  = true
swap_size_gb = 0  # 0 = auto-calculate

#############################################
# Scaling, Autoresize & Cost Control
#############################################

# EBS autogrow for /moodledata (alarm -> SSM Automation)
enable_ebs_autogrow            = true
ebs_autogrow_threshold_percent = 80
ebs_autogrow_increment_percent = 25
ebs_autogrow_max_size_gb       = 200

# Weekly compute autoresize: "notify" only recommends, "apply" upsizes one step
# (EC2 stop/start = 2-5 min downtime; RDS waits for the maintenance window)
enable_compute_autoresize = false
compute_autoresize_mode   = "notify"
ec2_instance_type_ladder  = ["t4g.small", "t4g.medium", "t4g.large", "t4g.xlarge"]
rds_instance_class_ladder = ["db.t4g.micro", "db.t4g.small", "db.t4g.medium", "db.t4g.large"]
autoresize_schedule       = "cron(0 8 ? * SUN *)"  # Sunday 03:00 Colombia (UTC-5)

cpu_high_threshold_percent = 70
cpu_credit_low_threshold   = 50

# Alerts and budget (empty list = no email subscriptions / budget notifications)
scaling_alert_emails = []  # e.g. ["ops@example.com"]
monthly_budget_usd   = 30

#############################################
# SES SMTP (Moodle outbound mail, ses.tf)
#############################################

# WARNING: with enable_ses_smtp = true the SMTP password and IAM secret key are
# stored in Terraform state. Enable the encrypted S3 backend first (see the
# commented backend "s3" block in main.tf) and never commit terraform.tfstate*.
enable_ses_smtp = false

ses_domain              = ""              # empty = domain_name
ses_mail_from_subdomain = ""              # e.g. "mail" -> mail.<ses_domain> (custom MAIL FROM)
ses_manage_spf          = false           # root TXT often exists already; merge include:amazonses.com manually
ses_dmarc_policy        = "p=quarantine"  # empty = do not manage _dmarc
ses_dmarc_rua_email     = ""              # e.g. "dmarc@example.com"
ses_smtp_key_version    = "1"             # bump to rotate the SMTP credentials
ses_smtp_user_param     = ""              # empty = /<project_name>/<environment>/ses/smtp-user
ses_smtp_pass_param     = ""              # empty = /<project_name>/<environment>/ses/smtp-password
kms_key_id              = ""              # empty = AWS-managed aws/ssm key
ses_enable_account_suppression = true     # ACCOUNT-WIDE suppression list (BOUNCE, COMPLAINT)

# DNS: Route 53 records are created when route53_zone_id (above) is set;
# otherwise see `terraform output ses_dns_records_manual`.
# SES sandbox exit (production access) is still a manual request in the console.

#############################################
# Moodle Configuration
#############################################

# NOTE: Moodle 5.3 LTS requires Apache DocumentRoot to point to /var/www/html/moodle/public
# PHP 8.4 on Amazon Linux 2023 (min 8.3, 8.5 not supported)

moodle_version        = "MOODLE_503_STABLE"
moodle_admin_user     = "admin"
moodle_admin_password = "AdminPass123!"  # CHANGE THIS!
moodle_site_name      = "My Learning Platform"
moodle_site_summary   = "Online courses and training"

#############################################
# Resource Tags
#############################################

tags = {
  Project     = "Moodle 5.3 LTS"
  ManagedBy   = "Terraform"
  Environment = "Production"
  Owner       = "your-name"
  CostCenter  = "education"
}
